{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux",
  "pythonPath": ".venv/bin/python",
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none",
  "include": [
    "api",
    "core",
    "tools",
    "safety",
    "voice"
  ],
  "exclude": [
    ".venv",
    "**/__pycache__",
    "**/node_modules"
  ]
}

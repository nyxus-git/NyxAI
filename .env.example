# ─── NyxAI Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=NyxAI
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ─── API Server ───────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ─── Ollama LLM ───────────────────────────────────────────────────────────────
# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for inference.
# Recommended for 6GB VRAM: qwen2.5:3b
# Other options: llama3.2:3b, gemma2:2b, phi3.5:mini
# Pull with: ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# Request timeout in seconds
OLLAMA_TIMEOUT=120

# ─── Conversation ─────────────────────────────────────────────────────────────
# Maximum tokens to send in conversation context
MAX_CONVERSATION_TOKENS=4096

# Default language for NyxAI responses
# Options: auto, en, hi, mr
DEFAULT_LANGUAGE=auto

# ─── Voice / STT / TTS (Phase 3) ──────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=auto

TTS_ENGINE=kokoro
TTS_VOICE=af_heart
TTS_SPEED=1.0

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# ─── Hugging Face Token ───────────────────────────────────────────────────────
# HF_TOKEN=
